# Copy to .env and adjust. Every value has a working default, so .env is optional.

# Default: a local SQLite file, no external service required.
DATABASE_URL=sqlite:///./quartermaster.db

# PostgreSQL instead:
# DATABASE_URL=postgresql+psycopg://quartermaster:quartermaster@localhost:5432/quartermaster

# Log every SQL statement. Useful when working on the repository layer.
SQL_ECHO=false
